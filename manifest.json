{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "Alerte sur les sites GenAI, par Next.ink",
  "version": "2.3.1",
  "description": "Affiche une alerte sur des sites générés tout ou partie par des IA. Liste gérée par Next.ink",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://dl.red.flag.domains/*",
    "https://next.ink/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "browser-polyfill.min.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icone-app_ia16.png",
      "32": "icone-app_ia32.png",
      "48": "icone-app_ia48.png",
      "64": "icone-app_ia64.png",
      "128": "icone-app_ia128.png"
    }
  },
  "options_ui": {
    "page": "admin.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [{
    "resources": [
      "bloom-filter.json",
      "test.txt",
      "test2.txt",
      "admin.html"
    ],
    "matches": ["<all_urls>"]
  }],
  "icons": {
    "16": "icone-app_ia16.png",
    "32": "icone-app_ia32.png",
    "48": "icone-app_ia48.png",
    "64": "icone-app_ia64.png",
    "128": "icone-app_ia128.png"
  }
}